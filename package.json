{
  "name": "meetnow",
  "version": "1.0.0",
  "private": true,
  "author": "Arthur Maslo and Team Gofer",
  "license": "UNLICENSED",
  "description": "MeetNow - Real-time Local Meetup Platform",
  "copyright": "Copyright (c) 2025 Arthur Maslo and Team Gofer. All Rights Reserved.",
  "homepage": "https://meetnow.app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cypress:run",
    "test:all": "npm run test && npm run test:e2e",
    "test:groups": "node test-runner.js",
    "test:basic": "node test-runner.js basic",
    "test:map": "node test-runner.js map",
    "test:debug": "node test-runner.js debug",
    "test:ui": "node test-runner.js ui",
    "lint": "eslint src --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "ui-demo": "vite --config vite.ui-demo.config.js src/features/ui-poc/index.html",
    "ui-demo-simple": "open src/features/ui-poc/demo.html",
    "ui-cards": "open src/features/ui-poc/cards.html",
    "ui-nav": "open src/features/ui-poc/navigation.html",
    "ui-showcase": "open src/features/ui-poc/showcase.html",
    "ui-neumorphic": "open src/features/ui-poc/neumorphic.html",
    "ui-drift": "open src/features/ui-poc/neumorphic-drift.html",
    "ui-ocean": "open src/features/ui-poc/neumorphic-ocean.html",
    "ui-complete": "open src/features/ui-poc/neumorphic-complete.html",
    "ui-navigation-icons": "open src/features/ui-poc/navigation-icons.html",
    "ui-action-icons": "open src/features/ui-poc/action-icons.html",
    "ui-interaction": "open src/features/ui-poc/interaction-icons.html",
    "ui-media": "open src/features/ui-poc/media-icons.html",
    "ui-charts": "open src/features/ui-poc/chart-icons.html",
    "ui-icons": "open src/features/ui-poc/icon-components.html",
    "ui-components": "open src/features/ui-poc/neumorphic-components.html"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.2",
    "@supabase/auth-helpers-react": "^0.4.0",
    "@supabase/supabase-js": "^2.39.7",
    "chalk": "^4.1.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "leaflet": "^1.9.4",
    "leaflet.locatecontrol": "^0.79.0",
    "lucide-react": "^0.483.0",
    "next": "^13.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^5.0.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.15",
    "@babel/preset-env": "^7.22.15",
    "@babel/preset-react": "^7.22.15",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.14",
    "babel-jest": "^29.6.4",
    "cypress": "^13.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^29.6.4",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "start-server-and-test": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.1.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup.js"
    ],
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/tests/**/*",
      "!src/vite-env.d.ts",
      "!src/main.jsx"
    ]
  }
}
