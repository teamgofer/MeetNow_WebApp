{
  "name": "meetnow-webapp",
  "version": "1.0.1",
  "private": true,
  "author": "Arthur Maslo and Team Gofer",
  "license": "UNLICENSED",
  "description": "MeetNow - Real-time Local Meetup Platform",
  "copyright": "Copyright (c) 2025 Arthur Maslo and Team Gofer. All Rights Reserved.",
  "homepage": "https://meetnow.app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "vitest run --coverage",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cypress:run",
    "test:all": ":npm run test && npm run test:e2e",
    "test:groups": "node test-runner.js",
    "test:basic": "node test-runner.js basic",
    "test:map": "node test-runner.js map",
    "test:debug": "node test-runner.js debug",
    "test:ui": "vitest --ui",
    "organize:tests": "node scripts/organize-tests.js",
    "cleanup:legacy": "node scripts/cleanup-legacy-code.js",
    "cleanup:preview": "node scripts/cleanup-legacy-code.js --preview-only",
    "cleanup:demos": "node scripts/cleanup-legacy-code.js --move-demos",
    "update:test-imports": "node scripts/update-test-imports.js",
    "project:cleanup": "npm run cleanup:preview && npm run organize:tests && npm run update:test-imports && npm run cleanup:legacy",
    "lint": "node scripts/lint-typescript.js",
    "lint:fix": "node scripts/lint-typescript.js --fix",
    "lint:summary": "node scripts/lint-typescript.js --summary",
    "lint:ts": "eslint --config .eslintrc.cjs 'src/**/*.{ts,tsx}' --max-warnings=0",
    "lint:ts:fix": "eslint --config .eslintrc.cjs 'src/**/*.{ts,tsx}' --fix",
    "lint:file": "node scripts/lint-typescript.js",
    "lint:staged": "lint-staged",
    "type-check": "node scripts/type-check.js",
    "type-check:strict": "tsc --project tsconfig.json --noEmit --strict",
    "type-check:watch": "tsc --project tsconfig.json --noEmit --watch",
    "type-check:report": "node scripts/type-check.js --report",
    "type-check:file": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "validate": "npm run lint:summary && npm run type-check && npm run test",
    "ui-demo": "vite --config vite.ui-demo.config.js src/features/ui-poc/index.html",
    "ui-demo-simple": "open src/features/ui-poc/demo.html",
    "ui-cards": "open src/features/ui-poc/cards.html",
    "ui-nav": "open src/features/ui-poc/navigation.html",
    "ui-showcase": "open src/features/ui-poc/showcase.html",
    "ui-neumorphic": "open src/features/ui-poc/neumorphic.html",
    "ui-drift": "open src/features/ui-poc/neumorphic-drift.html",
    "ui-ocean": "open src/features/ui-poc/neumorphic-ocean.html",
    "ui-complete": "open src/features/ui-poc/neumorphic-complete.html",
    "ui-navigation-icons": "open src/features/ui-poc/navigation-icons.html",
    "ui-action-icons": "open src/features/ui-poc/action-icons.html",
    "ui-interaction": "open src/features/ui-poc/interaction-icons.html",
    "ui-media": "open src/features/ui-poc/media-icons.html",
    "ui-charts": "open src/features/ui-poc/chart-icons.html",
    "ui-icons": "open src/features/ui-poc/icon-components.html",
    "ui-components": "open src/features/ui-poc/neumorphic-components.html",
    "start": "react-scripts start",
    "eject": "react-scripts eject",
    "prepare": "[ -z \"$HUSKY\" ] && husky && husky install || echo \"Skipping husky install\"",
    "version:patch": "npm version patch && git push && git push --tags",
    "version:minor": "npm version minor && git push && git push --tags",
    "version:major": "npm version major && git push && git push --tags",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "npm run test:all && npm run build && standard-version",
    "reorganize": "node scripts/reorganize.js",
    "update-imports": "node scripts/update-imports.js",
    "folder-cleanup": "npm run reorganize && npm run update-imports && npm test",
    "refactor:analyze": "node scripts/analyze-large-files.mjs",
    "refactor:type-check": "tsc --project tsconfig.refactor.json",
    "refactor:lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "refactor:prepare": "npm run refactor:analyze && npm run type-check && npm run refactor:lint",
    "refactor:watch": "tsc --project tsconfig.refactor.json --watch",
    "refactor:test": "vitest --config vitest.refactor.config.ts",
    "ts:find-problems": "node scripts/type-check.js --report --summary",
    "ts:fix-imports": "tsc-import-fix src",
    "ts:check-compatibility": "api-extractor run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.772.0",
    "@aws-sdk/s3-request-presigner": "^3.772.0",
    "@radix-ui/react-progress": "^1.1.2",
    "@supabase/auth-helpers-react": "^0.4.0",
    "@supabase/supabase-js": "^2.39.7",
    "browser-image-compression": "^2.0.2",
    "chalk": "^4.1.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "emoji-picker-react": "^4.12.2",
    "framer-motion": "^12.6.3",
    "leaflet": "^1.9.4",
    "leaflet.locatecontrol": "^0.79.0",
    "lucide-react": "^0.483.0",
    "next": "^13.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^5.0.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.4.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.15",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/plugin-transform-optional-chaining": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.4.14",
    "babel-jest": "^29.6.4",
    "babel-plugin-transform-typescript": "^7.0.0-alpha.19",
    "core-js": "^3.41.0",
    "cypress": "^13.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-typescript": "^0.14.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^23.0.1",
    "lint-staged": "^15.5.0",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "start-server-and-test": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.3.0",
    "tsc-files": "^1.1.4",
    "typescript": "^5.8.2",
    "vite": "^5.1.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^1.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
